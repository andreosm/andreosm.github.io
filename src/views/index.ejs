<!DOCTYPE html>
<html lang="en" data-page-title="pageTitle">
    <%- include("partials/head") %>
    <body>

        <%- include("partials/postcard-frame") %>
        <%- include("partials/desktop-artwork") %>
        <%- include("partials/navigation") %>
        <%- include("partials/mobile-navigation") %>

        <main id="pageContent">
            <div class="container col-lg-6 pt-2 pt-md-3 pt-lg-4">
                <h2 id="event-title" class="kaushan-script text-center"></h2>
                <div id="home-title" class="pageTitle text-center"></div>
                <h5 id="" class="text-center"></h5>   
                <%- include("partials/language-selector") %>
                <div class="card mt-4">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div id="home-header-left" class="col text-start text-emoji-medium"></div>
                            <div id="<%= navigation?.guest?.identified ? 'home-header-center-name' : 'home-header-center-date' %>" class="col text-center fs-xl ls-md fw-bold kaushan-script"><span><%= navigation?.guest?.identified ? (navigation?.guest?.curGuest?.salutation + " " + navigation?.guest?.curGuest?.relationship + " " + navigation?.guest?.curGuest?.firstName) : "" %></span></div>
                            <div id="home-header-right" class="col text-end text-emoji-medium"></div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="home-content1" class="text-center"></div>
                        <div class="container countdown-container text-center demo-box-green mt-3">
                            <hr/>
                            <div class="row">
                                <div class="col fs-lg fw-bold kaushan-script" id="home-days"></div>
                                <div class="col fs-lg fw-bold kaushan-script" id="home-hours"></div>
                                <div class="col fs-lg fw-bold kaushan-script" id="home-minutes"></div>
                                <div class="col fs-lg fw-bold kaushan-script" id="home-seconds"></div>
                            </div>
                            <hr/>
                            <div class="row">
                                <div class="col" id="countdownDays"></div>
                                <div class="col" id="countdownHours"></div>
                                <div class="col" id="countdownMinutes"></div>
                                <div class="col" id="countdownSeconds"></div>
                            </div> 
                            <hr/>
                            <div id="home-timezone" class="mb-4"></div>
                            
                            <!-- <img 
                                id="fadedPostcard1"
                                data-localized-src="postcard-faded-home1.png"
                                class="desktop-art home-page"
                                alt=""
                            >
                            <img 
                                id="fadedPostcard2"
                                data-localized-src="postcard-faded-home2.png"
                                class="desktop-art home-page"
                                alt=""
                            > -->
                            <div class="row align-items-center g-4 pb-5">

                                <!-- Photo --> <!-- 1086X1448-->
                                <div class="col-12 col-lg-6">
                                    <img
                                    src="/images/photos/Route67-9.png"
                                    
                                    alt="Route 67"
                                    style="width:217px; height: 289px;"
                                    >
                                </div>
                                
                                <div class="col-12 col-lg-6 align-items-center">
                                    <div id="route-67-title" class="pb-2"></div> 
                                    <% if (navigation.guest.identified == true && navigation.guest.finished == true) { %>
                                        <span id="daysLeft"></span>
                                        <span id="route-67-content-2"></span>
                                    <% } else { %>
                                        <span id="daysLeft"></span>
                                        <span id="route-67-content-1"></span>
                                    <% } %>
                                </div>
                            </div>
                            
                                <% if (navigation.stepper) { %>
                                    <%- include("partials/stepper", {
                                        steps: navigation.steps,
                                        stepper: navigation.stepper
                                    }) %>
                                <% } %>

                           
                        </div>
                        
                    </div>                   
                    <%- include("partials/buttons") %>
                </div>            
            </div>
            
        </main>        

        <%- include("partials/footer") %>
        <script type="module" src="/js/countdown.js"></script>
    
    </body>
</html>