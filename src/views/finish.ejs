<!DOCTYPE html>
<html lang="en" data-page-title="pageTitle">
    <%- include("partials/head") %>
    <body>

        <%- include("partials/postcard-frame") %>
        <%- include("partials/desktop-artwork") %>
        <%- include("partials/navigation") %>
        <%- include("partials/mobile-navigation") %>

        <main id="pageContent">
            <div class="container col-lg-6 pt-2 pt-md-3 pt-lg-4">
                <h2 id="event-title" class="kaushan-script text-center"></h2>
                <div id="" class=" text-center"></div>
                <h5 id="" class="text-center"></h5>   
                <div class="pt-4"><%- include("partials/stepper", { steps, stepper }) %></div>
                
                <div class="card mt-4">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div id="finish-header-left" class="col text-start text-emoji-medium"></div>
                            <div id="finish-thankyou" class="col text-center cardTitle"></div><span> <%= navigation?.displayGuest?.firstName.length > 0 ? navigation?.displayGuest?.firstName : '' %></span>
                            <div id="finish-header-right" class="col text-end text-emoji-medium"></div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="finish-content1" class="text-center"></div>                   
                    </div>
                    <div class="pt-4"><%- include("partials/buttons") %></div>
                    
                </div>            
            </div>
        </main>        

        <%- include("partials/footer") %>
        <script type="module" src="/js/countdown.js"></script>
    
    </body>
</html>