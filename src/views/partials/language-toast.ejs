<div class="toast-container position-fixed bottom-0 end-0 p-3">

    <div id="languageToast"
        class="toast"
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
    >

        <div class="toast-header">

            <strong id="languageToastHeader" class="me-auto"></strong>

            <small id="languageToastTitle"></small>

            <button type="button"
                class="btn-close"
                data-bs-dismiss="toast"
                aria-label="Close">
            </button>

        </div>

        <div id="languageToastBody" class="toast-body"></div>

    </div>

</div>