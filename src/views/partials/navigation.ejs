                </a>
            </li>
            

            <li class="nav-item" id="navTheParty">
                <a class="nav-link <%= navigation.nav.navBar.active  === 'party' ? 'active' : '' %>" href="/party" id="menu-party">
                    
                </a>
            </li>
            
            <li class="nav-item">
                <a class="nav-link <%= navigation.nav.navBar.active  === 'rsvp' ? 'active' : '' %>" href="/rsvp" id="menu-rsvp">
                    
                </a>
            </li>

           <li class="nav-item">
                <a class="nav-link <%= navigation.nav.navBar.active  === 'star' ? 'active' : '' %>" href="/star?sp=1" id="menu-star">
                    
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link <%= navigation.nav.navBar.active  === 'venue' ? 'active' : '' %>" href="/venue" id="menu-venue">
                    
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= navigation.nav.navBar.active  === 'food' ? 'active' : '' %>" href="/food" id="menu-food">
