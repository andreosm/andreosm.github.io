                <a class="nav-link <%= navigation.nav.navBar.active  === 'beverages' ? 'active' : '' %>" href="/beverages" id="menu-beverage">
                
                </a>
            </li>
 
            <!-- <li class="nav-item">
                <a class="nav-link <%= navigation?.nav.active.active  === 'photos' ? 'active' : '' %>" href="/photos?s=m" id="menu-photos">
                    
                </a>
            </li> -->
            
                <li class="nav-item">
                    <a class="nav-link" href="/logout" id="menu-logout"></a>
                </li>
        
        </ul>
        <!-- LANGUAGE SELECTOR -->
        <!-- <hr /> -->
        <!-- <div class="d-flex flex-column flex-lg-row gap-2"> -->
            <div class="language-selector">
                <button
                    type="button"
                    class="language-button"
                    data-language="en"
                    aria-label="English">
                    <img src="/images/flags/us.svg" alt="English">
                </button>
                <button
                    type="button"
                    class="language-button"
                    data-language="it"
                    aria-label="Italiano">
                    <img src="/images/flags/it.svg" alt="Italiano">
                </button>
                <button
                    type="button"
                    class="language-button"
                    data-language="pt"
                    aria-label="Português">
                    <img src="/images/flags/br.svg" alt="Português">
                </button>
            </div>
        <!-- </div> -->

        
    </nav>

    <!-- HAMBURGER -->
    <button
        id="hamburgerButton"
        class="hamburger-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobileNav"
    >
        ☰
    </button>

<%- include("language-toast") %>