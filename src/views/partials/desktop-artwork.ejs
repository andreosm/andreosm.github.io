<picture class="skyline-picture">

    <source
        media="(max-width: 980px)"
        srcset="/images/css/skyline-980.png">

    <source
        media="(max-width: 1024px)"
        srcset="/images/css/skyline-1024.png">

    <source
        media="(max-width: 1280px)"
        srcset="/images/css/skyline-1280.png">

    <source
        media="(max-width: 1440px)"
        srcset="/images/css/skyline-1440.png">

    <source
        media="(max-width: 1600px)"
        srcset="/images/css/skyline-1600.png">

    <img id="skyline"
        class="skyline"
        src="/images/css/skyline-1920.png"
        alt="">

</picture>