<div class="d-flex button-pair">
     <% if (navigation.back.visible && navigation.next.visible) { %>
        <a class="btn btn-outline-dark ma-button w-50"
            href="<%= navigation.back.url %>">
            <i class="bi bi-arrow-left"></i>
            <span id="buttonBack"></span>
        </a>

        <% if (navigation.next.action === "navigate") { %>
            <a class="btn btn-outline-dark ma-button w-50"
                href="<%= navigation.next.url %>">
                <span id="buttonNext"></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        <% } %>

        <% if (navigation.next.action === "toggle") { %>
            <a href="#" class="btn btn-outline-dark ma-button w-50 toggle-element" onclick="toggleElements()">
                <span id="buttonNext"></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        <% } %>

        <% if (navigation.next.action === "submit") { %>
            <button type="submit"
                class="btn btn-outline-dark ma-button w-50">
                <i class="bi bi-arrow-right"></i>
                <span id="buttonNext"></span>
            </button>
        <% } %>
    <% } %>  
    
    <% if (!navigation.back.visible && navigation.next.visible) { %>
        <% if (navigation.next.action === "navigate") { %>
            <a class="btn btn-outline-dark ma-button w-100"
                href="<%= navigation.next.url %>">
                <span id="buttonNext"></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        <% } %>

        <% if (navigation.next.action === "toggle") { %>
            <a href="#" class="btn btn-outline-dark ma-button w-100 toggle-element" onclick="toggleElements()">
                <span id="buttonNext"></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        <% } %>

        <% if (navigation.next.action === "submit") { %>
            <button type="submit"
                class="btn btn-outline-dark ma-button w-100">
                <i class="bi bi-arrow-right"></i>
                <span id="buttonNext"></span>
            </button>
        <% } %>
    <% } %>


    <% if (navigation.back.visible && !navigation.next.visible) { %>
        <a class="btn btn-outline-dark ma-button w-100"
            href="<%= navigation.back.url %>">
            <i class="bi bi-arrow-left"></i>
            <span id="buttonBack"></span>
        </a>
    <% } %>
</div>