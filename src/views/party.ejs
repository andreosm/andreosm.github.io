<!DOCTYPE html>
<html lang="en" data-page-title="pageTitle">
    <%- include("partials/head") %>
    <body>

        <%- include("partials/postcard-frame") %>
        <%- include("partials/desktop-artwork") %>
        <%- include("partials/navigation") %>
        <%- include("partials/mobile-navigation") %>

        <main id="pageContent">
            <div class="container col-lg-6 pt-2 pt-md-3 pt-lg-4">
                <h2 id="event-title" class="kaushan-script text-center"></h2>
                <!-- <h5 id="party-title1" class="text-center"></h5> -->
                 <div class="pt-4"><%- include("partials/stepper") %></div>
                
                <div class="card mt-4">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div id="party-header-left" class="col text-start text-emoji-medium"></div>
                            <div id="party-header-center" class="col text-center cardTitle text-nowrap"></div>
                            <div id="party-header-right" class="col text-end text-emoji-medium"></div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="party-schedule" class="text-center font-add1 pb-2"></div>

                        <div class="text-center pb-4">
                            <img 
                                id="fadedPostcard1"
                                data-localized-src="postcard-faded-home1.png"
                                class="desktop-art home-page"
                                alt=""
                            >
                            <img 
                                id="fadedPostcard2"
                                data-localized-src="postcard-faded-home2.png"
                                class="desktop-art home-page"
                                alt=""
                            >
                        </div>
                        
                        <div class="strong text-center"><%= navigation?.displayGuest?.firstName %></div>
                        <div id="party-content1"></div>                        
                        <p><div class="strong text-center"><span><%= navigation?.displayGuest?.relationship.charAt(0).toUpperCase() + navigation?.displayGuest?.relationship.slice(1) %></span><span id="party-curious"></span></div></p>
                        <div id="party-curious"></div>
                        <div id="party-content2" class="pt-1"></div>
                        <h5 id="party-title2" class="kaushan-script text-center"></h5>
                        <div id="party-content2" class="pt-2"></div>
                        <div id="<%= navigation.finished ? 'about-star' : 'party-next' %>" class="text-center"></div>
                        
                    </div>
                    <%- include("partials/buttons") %>
                </div>
            </div>
            

            <div class="mobile-art mobile-date">
                <img src="/images/css/postcard-date-bg.png" alt="">
            </div>
            
            <div id="party-content1" class="content"></div>
            
            <div id="party-content2" class="content"></div>

            
        </main>

        <%- include("partials/footer") %>
        <!-- <script src="/js/resize.js"></script>
        <script type="module" src="/js/language.js"></script> -->
        <!-- <script type="module" src="/js/menuAccess.js"></script>
        <script>
            localStorage.setItem("partyVisited", "true");
        </script> -->
    </body>
</html>